# Copier en `.env.local` (ignoré par git) et adapter au besoin.

# URL du service backend/auth. Par défaut http://localhost:8001 si absent.
# VITE_AUTH_API_URL=http://localhost:8001

# --- Mode dev SANS backend Auth / PostgreSQL ---------------------------------
# Utile pour tester une fonctionnalité isolée (ex. marketplace, business...)
# sans avoir à installer/lancer Docker, PostgreSQL et le service auth.
# Simule une connexion automatique avec un utilisateur fictif au chargement
# de l'app. N'appelle jamais l'API auth tant que ce flag est actif.
#
# À NE PAS committer activé, et à ne jamais utiliser en production.
# VITE_SKIP_AUTH=true
# VITE_SKIP_AUTH_ROLE=farmer   # ou "acheteur"

VITE_SKIP_AUTH=true
VITE_SKIP_AUTH_ROLE=farmer