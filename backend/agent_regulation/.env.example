# Clé API pour les embeddings Mistral (mistral-embed)
MISTRAL_API_KEY=

# Connexion au vector store Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agricultural_knowledge

# Clé API Tavily (https://tavily.com) pour la recherche web (aides financières, procédures)
WEB_SEARCH_API_KEY=

# Chemin local du vector store (si utilisation d'un Qdrant embarqué)
VECTORSTORE_PATH=data/vectorstore

# Connexion PostgreSQL (table `subsidies` — cache des aides financières).
# Optionnel : par défaut, pointe déjà vers le port exposé par
# `docker-compose up -d db` en local (voir database/schema.sql, app/db.py).
DATABASE_URL=postgresql://agriadvisor:changeme@localhost:5434/agriadvisor
