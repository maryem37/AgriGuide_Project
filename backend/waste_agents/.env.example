# Copy this file to .env and fill in your keys.
# Never commit your real .env file.

# ------------------------------------------------------------------
# LLM (required)
# ------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
LLM_PROVIDER=mistral
LLM_TEMPERATURE=0.0
MAX_SEARCH_QUERIES_PER_CROP=3
EXTRACTION_MAX_WORKERS=5

# ------------------------------------------------------------------
# General web search (required for autonomous research)
# Choose ONE provider and set WEB_SEARCH_PROVIDER accordingly.
# ------------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------
# Academic search (optional keys — both APIs work without one,
# but providing them raises rate limits)
# ------------------------------------------------------------------
# SEMANTIC_SCHOLAR_API_KEY=your_key_here
CROSSREF_MAILTO=

# ------------------------------------------------------------------
# Embeddings / vector store
# ------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=agri_waste_knowledge

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development
UI_LANGUAGE=fr

# AgriGuide HTTP API (read-only KB for agriculture / marketplace UX):
#   cd backend/waste_agents && uvicorn api.main:app --reload --port 8004
# Frontend: VITE_AGENT_WASTE_URL=http://localhost:8004

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agri-waste-agent


