# Base de données
DB_PASSWORD=changeme
# Hostname `db` = réseau Docker Compose. En local (uvicorn hors Docker),
# agent_agriculture réécrit automatiquement vers localhost:5434 si `db`
# n'est pas résolvable (port publié dans docker-compose.yml).
DATABASE_URL=postgresql://agriadvisor:changeme@db:5432/agriadvisor

# Auth
JWT_SECRET_KEY=changeme-generate-a-long-random-secret

# LLM
MISTRAL_API_KEY=

# APIs externes — Agriculture Advisor
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# SoilGrids, NASA POWER, Open-Meteo, Open-Elevation : pas de clé requise (APIs ouvertes)

# APIs externes — Business / Marketplace (prix de marché)
RNM_FRANCEAGRIMER_API_KEY=
# Shared market data folder (FDS_IPPAP_*.csv + FranceAgriMer_*.pdf). Default: ./data
MARKET_DATA_DIR=
AGRESTE_DATA_DIR=
# RAG auto-enables when Chroma index exists + MISTRAL_API_KEY. Force off with 0.
MARKET_RAG_ENABLED=
FRANCEAGRIMER_PDF_DIR=

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
